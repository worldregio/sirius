---
title: "Measuring Diversity of News Text"
subtitle: "An application to Covid-19 crisis"
author: "Claude Grasland"
date: "20/08/2020"
output: html_document
---

```{r setup, include=FALSE}
knitr::opts_chunk$set(echo = TRUE)
library(quanteda)
library(quanteda.textplots)
library(quanteda.textstats)
library(data.table)
library(dplyr)
library(ggplot2)
library(zoo)

```


# DATA 

We load metadata and data

## Load meta
```{r}
meta <- fread("mediacloud_corpus_25_countries.csv")
```

## Load data

```{r}
media<-"FRA_figaro"
lang="fr"
title_only=TRUE
t1<-as.Date("2013-07-01")
t2<-as.Date("2020-07-01")

myfile<-paste("net/",media,"/data/",media,".RDS", sep="")
dt<-readRDS(myfile)
qd<-corpus(dt,text_field = "title")
```


# SAMPLING

We agreggate the titles of news by month for two period
```{r}

qd1<-qd %>% corpus_subset(as.Date(date) > t1-15) %>%
            corpus_subset(as.Date(date) < t2+15)


#
#if(title_only) {texts(qd1)<-qd1$title} else #{texts(qd1)<-paste(qd1$title, texts(qd1), sep=". ")}

qd1$weeks<-cut(as.Date(qd1$date), "weeks")
```

# TOKENIZE & COMPUTE

```{r}
toks<-tokens(qd1)
dfmat<-dfm(toks) %>% dfm_remove(stopwords(language = lang)) %>%  dfm_group(weeks)
head(dfmat)
 
lexdiv <- textstat_lexdiv(dfmat,measure = c("K"))
lexdiv$date<-as.Date(lexdiv$document)
lexdiv$K4 =rollmean(lexdiv$K, k=4, align="center", fill=NA)
lexdiv<-lexdiv[lexdiv$date >= t1,]
lexdiv<-lexdiv[lexdiv$date <= t2,]

?texstat_lexdiv()
```



# VISUALIZE

```{r}
mytitle=paste("Media = ",media, " - language = ",lang)

p2<-ggplot(lexdiv, aes(x=date,y=K4))+
   geom_line(aes(y=-K),lwd=0.6,col="gray70")+
    geom_line(aes(y=-K4),lwd=1, col="red")+
  scale_x_date("time",limits=c(t1,t2), date_breaks="1 year",date_labels = "%b%y", minor_breaks=NULL) +
  scale_y_continuous("Yule's K index of lexical diversity",limits=c(min(-lexdiv$K4),max(-lexdiv$K4)))+
  labs(title = "Lexical diversity of news titles", subtitle=mytitle)

p2


```


# SAVE

```{r}
ggsave(plot = p2,
       filename = paste("title_",media,"_",lang,"_long.pdf", sep=""),
       device = "pdf",
       width = 8,
       height=6
        )
```

